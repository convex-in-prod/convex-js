+    writeFileSync(
+      path.join(tmpDir.path, "convex", "tsconfig.json"),
+      JSON.stringify({
+        compilerOptions: { noEmit: false, types: [], lib: ["es2020"] },
+      }),
+    );
+    writeFileSync(sourcePath, "const value: number = 1;");
