+type ClientWrapper = {
+  connectionState(): unknown;
+  retryDegradableQueries(epoch: number): boolean;
+  close(): Promise<void> | void;
+};
+
+const clientWrappers: Array<
+  [string, (address: string, options: BaseConvexClientOptions) => ClientWrapper]
+> = [
