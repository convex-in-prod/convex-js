+          }),
+      );
+      const client = new ConvexHttpClient("https://occ.convex.cloud", {
+        fetch: localFetch,
+      });
+
+      const failure = await client
+        .mutation(
+          mutation,
+          { value: "test" },
+          {
+            maxWriteConflictRetries,
+            writeConflictRetryDelayMs: 0,
