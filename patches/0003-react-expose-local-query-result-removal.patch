-      localQueryLogs: () => {
+      hasLocalQueryResult: () => {
         if (this.cachedSync) {
-          return this.cachedSync.localQueryLogs(name, args);
+          return this.cachedSync.localQueryLogs(name, args) !== undefined;
         }
-        return undefined;
+        return false;
