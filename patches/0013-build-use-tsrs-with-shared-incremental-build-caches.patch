+import { lstatSync, readFileSync, readdirSync, unlinkSync } from "node:fs";
+import { homedir } from "node:os";
+import { dirname, join, relative, resolve, sep } from "node:path";
+
+export function projectTsrsCacheRoot(projectRoot, environment = process.env) {
+  let cacheRoot = environment.TSRS_CACHE_DIR;
+  if (cacheRoot === undefined) {
+    const cacheHome =
+      environment.XDG_CACHE_HOME ??
+      (process.platform === "darwin"
+        ? join(homedir(), "Library", "Caches")
+        : join(homedir(), ".cache"));
+    if (cacheHome === "")
+      throw new Error("Compiler cache paths must not be empty.");
+    cacheRoot = join(cacheHome, "tsrs");
+  }
+  if (cacheRoot === "")
+    throw new Error("Compiler cache paths must not be empty.");
+  const packageJson = JSON.parse(
+    readFileSync(join(projectRoot, "package.json"), "utf8"),
+  );
+  if (
+    packageJson === null ||
+    typeof packageJson !== "object" ||
+    Array.isArray(packageJson)
+  ) {
+    throw new Error("The project package manifest must be an object.");
+  }
+  if (packageJson.name !== undefined && typeof packageJson.name !== "string") {
+    throw new Error("The project package name must be a string when provided.");
+  }
+  const namespace =
+    environment.TSRS_CACHE_NAMESPACE ??
+    (packageJson.name ?? "project")
+      .replace(/^@/u, "")
+      .replace(/[^A-Za-z0-9._-]+/gu, "-")
+      .toLowerCase();
+  if (!/^[a-z0-9][a-z0-9._-]{0,213}$/u.test(namespace)) {
+    throw new Error("TSRS_CACHE_NAMESPACE must be a simple non-empty name.");
+  }
+  return resolve(cacheRoot, namespace);
+}
+
+export function tsrsCacheRetentionDays(
+  value = process.env.TSRS_CACHE_RETENTION_DAYS ?? 30,
+) {
+  const days = Number(value);
+  if (
+    value === "" ||
+    !Number.isFinite(days) ||
+    days < 0 ||
+    !Number.isSafeInteger(days * 86_400_000)
+  ) {
+    throw new Error(
+      "TSRS cache retention days must be a non-negative duration in whole milliseconds.",
+    );
+  }
+  return days;
+}
+
+export function maintainTsrsCache({
+  projectRoot,
+  environment = process.env,
+  retentionDays = tsrsCacheRetentionDays(
+    environment.TSRS_CACHE_RETENTION_DAYS ?? 30,
+  ),
+  apply = false,
+  now = Date.now(),
+}) {
+  const cacheDirectory = projectTsrsCacheRoot(projectRoot, environment);
+  retentionDays = tsrsCacheRetentionDays(retentionDays);
+  if (!Number.isSafeInteger(now))
+    throw new Error(
+      "TSRS cache maintenance requires a whole-millisecond timestamp.",
+    );
+  const cutoff =
+    (BigInt(now) - BigInt(retentionDays * 86_400_000)) * 1_000_000n;
+  const report = {
+    cacheDirectory,
+    apply,
+    retentionDays,
+    completed: { files: 0, bytes: 0 },
+    eligible: { files: 0, bytes: 0 },
+    removed: { files: 0, estimatedBytes: 0 },
+    preserved: { files: 0, bytes: 0, directories: 0 },
+    changedOrMissing: 0,
+    candidates: [],
+  };
+  for (const path of [dirname(cacheDirectory), cacheDirectory]) {
+    const state = lstatSync(path, { throwIfNoEntry: false });
+    if (state === undefined) return report;
+    if (
+      !state.isDirectory() ||
+      (typeof process.getuid === "function" && state.uid !== process.getuid())
+    ) {
+      throw new Error(
+        "The tsrs cache root and project cache must be real owned directories.",
+      );
+    }
+  }
+  const archives = join(cacheDirectory, "declarations-v1");
+  const archiveState = lstatSync(archives, { throwIfNoEntry: false });
+  if (archiveState === undefined || !archiveState.isDirectory()) return report;
+
+  function walk(directory) {
+    for (const entry of readdirSync(directory, { withFileTypes: true })) {
+      const path = join(directory, entry.name);
+      const state = lstatSync(path, { bigint: true, throwIfNoEntry: false });
+      if (state === undefined) {
+        report.changedOrMissing += 1;
+        continue;
+      }
+      if (state.isDirectory()) {
+        report.preserved.directories += 1;
+        if (!entry.name.endsWith(".tmp")) walk(path);
+        continue;
+      }
+      const localPath = relative(cacheDirectory, path).split(sep).join("/");
+      if (
+        !/^declarations-v1\/[^/]+\/[a-z0-9]+-[a-z0-9_]+-[0-9a-f]{64}\/(?:public-types|internal-types|typecheck)\.tgz$/u.test(
+          localPath,
+        ) ||
+        !state.isFile() ||
+        state.nlink !== 1n ||
+        (typeof process.getuid === "function" &&
+          state.uid !== BigInt(process.getuid()))
+      ) {
+        report.preserved.files += 1;
+        report.preserved.bytes += Number(state.size);
+        continue;
+      }
+      report.completed.files += 1;
+      report.completed.bytes += Number(state.size);
+      if (state.mtimeNs > cutoff) continue;
+      report.eligible.files += 1;
+      report.eligible.bytes += Number(state.size);
+      report.candidates.push(localPath);
+      if (!apply) continue;
+      const current = lstatSync(path, { bigint: true, throwIfNoEntry: false });
+      if (
+        current === undefined ||
+        current.dev !== state.dev ||
+        current.ino !== state.ino ||
+        current.size !== state.size ||
+        current.mtimeNs !== state.mtimeNs ||
+        current.ctimeNs !== state.ctimeNs
+      ) {
+        report.changedOrMissing += 1;
+        continue;
+      }
+      try {
+        // Replacement between this check and unlink can also evict a completed entry. Readers
+        // retain archive bytes from one open, and every parent and publication file remains.
+        unlinkSync(path);
+        report.removed.files += 1;
+        report.removed.estimatedBytes += Number(state.size);
+      } catch (error) {
+        if (error.code !== "ENOENT") throw error;
+        report.changedOrMissing += 1;
+      }
+    }
+  }
+  walk(archives);
+  return report;
+}
diff --git a/scripts/tsrs-cache.test.mjs b/scripts/tsrs-cache.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..aff87ec3830a6e7ff5d639e0e54ce4b1b4129944
--- /dev/null
+++ b/scripts/tsrs-cache.test.mjs
@@ -0,0 +1,139 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import {
+  closeSync,
+  existsSync,
+  linkSync,
+  mkdirSync,
+  mkdtempSync,
+  openSync,
+  readFileSync,
+  renameSync,
+  rmSync,
+  statSync,
+  symlinkSync,
+  utimesSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+import { maintainTsrsCache, projectTsrsCacheRoot } from "./tsrs-cache.mjs";
+
+const repositoryRoot = dirname(dirname(fileURLToPath(import.meta.url)));
+
+function fixture(t) {
+  const root = mkdtempSync(join(tmpdir(), "tsrs-maintenance-"));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  const projectRoot = join(root, "project");
+  mkdirSync(projectRoot);
+  writeFileSync(join(projectRoot, "package.json"), '{"name":"cache-fixture"}');
+  const environment = { TSRS_CACHE_DIR: join(root, "cache") };
+  return {
+    projectRoot,
+    environment,
+    cache: projectTsrsCacheRoot(projectRoot, environment),
+  };
+}
+
+test("SDK maintenance preserves readers, writer paths, other projects, and unknown entries", (t) => {
+  const { projectRoot, environment, cache } = fixture(t);
+  const key = `declarations-v1/0.18.0/linux-x64-${"a".repeat(64)}`;
+  function publish(path, ageDays) {
+    mkdirSync(dirname(path), { recursive: true });
+    writeFileSync(`${path}.writer.tmp`, "complete");
+    renameSync(`${path}.writer.tmp`, path);
+    const time = new Date(Date.now() - ageDays * 86_400_000);
+    utimesSync(path, time, time);
+    return path;
+  }
+  const old = publish(join(cache, key, "public-types.tgz"), 40);
+  const kept = [
+    publish(join(cache, key, "internal-types.tgz"), 2),
+    publish(join(cache, key, "public-types.tgz.writer.tmp"), 40),
+    publish(join(cache, key, "unknown.tgz"), 40),
+    publish(join(cache, "future-format/entry.tgz"), 40),
+    publish(join(dirname(cache), "other-project", key, "public-types.tgz"), 40),
+    publish(join(projectRoot, "src/index.ts"), 40),
+    publish(join(projectRoot, "dist/index.d.ts"), 40),
+  ];
+  const link = join(
+    cache,
+    `declarations-v1/0.18.0/linux-x64-${"b".repeat(64)}`,
+    "typecheck.tgz",
+  );
+  mkdirSync(dirname(link));
+  symlinkSync(kept[5], link);
+  kept.push(link);
+  const hardlink = join(cache, key, "typecheck.tgz");
+  linkSync(kept[5], hardlink);
+  kept.push(hardlink);
+  // Recently read completed entries still expire by modification time.
+  utimesSync(old, new Date(), statSync(old).mtime);
+  const reader = openSync(old, "r");
+  t.after(() => closeSync(reader));
+  const dry = maintainTsrsCache({ projectRoot, environment });
+  assert.equal(dry.retentionDays, 30);
+  assert.equal(dry.eligible.files, 1);
+  assert.equal(dry.eligible.bytes, Buffer.byteLength("complete"));
+  assert.equal(dry.removed.files, 0);
+  assert.ok(existsSync(old));
+  const applied = spawnSync(
+    process.execPath,
+    [
+      join(repositoryRoot, "scripts/maintain-tsrs-cache.mjs"),
+      "--apply",
+      "--project-root",
+      projectRoot,
+    ],
+    {
+      env: {
+        ...process.env,
+        ...environment,
+        TSRS_CACHE_NAMESPACE: "cache-fixture",
+        TSRS_CACHE_RETENTION_DAYS: "30",
+      },
+      encoding: "utf8",
+    },
+  );
+  assert.equal(applied.status, 0, applied.stderr);
+  assert.equal(JSON.parse(applied.stdout).removed.files, 1);
+  assert.equal(
+    JSON.parse(applied.stdout).removed.estimatedBytes,
+    Buffer.byteLength("complete"),
+  );
+  assert.equal(existsSync(old), false);
+  assert.equal(readFileSync(reader, "utf8"), "complete");
+  for (const path of kept) assert.ok(existsSync(path), path);
+  assert.ok(statSync(dirname(old)).isDirectory());
+  renameSync(kept[1], old);
+  assert.equal(readFileSync(old, "utf8"), "complete");
+  assert.equal(
+    maintainTsrsCache({ projectRoot, environment, retentionDays: 1 }).eligible
+      .files,
+    2,
+  );
+});
+
+test("SDK cache namespaces support npm names, unnamed projects, and explicit roots with empty XDG", (t) => {
+  const { projectRoot, environment } = fixture(t);
+  const manifest = join(projectRoot, "package.json");
+  writeFileSync(manifest, JSON.stringify({ name: "x".repeat(214) }));
+  assert.equal(
+    projectTsrsCacheRoot(projectRoot, { ...environment, XDG_CACHE_HOME: "" }),
+    join(environment.TSRS_CACHE_DIR, "x".repeat(214)),
+  );
+  writeFileSync(manifest, "{}");
+  assert.equal(
+    projectTsrsCacheRoot(projectRoot, environment),
+    join(environment.TSRS_CACHE_DIR, "project"),
+  );
+  for (const value of [null, [], { name: 5 }]) {
+    writeFileSync(manifest, JSON.stringify(value));
+    assert.throws(
+      () => projectTsrsCacheRoot(projectRoot, environment),
+      /manifest|package name/u,
+    );
+  }
+});
