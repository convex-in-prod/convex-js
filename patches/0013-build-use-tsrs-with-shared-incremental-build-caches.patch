+    process.stdout.write(bytes.subarray(0, split));
+    process.stderr.write(bytes.subarray(0, split));
+    setTimeout(() => {
+      process.stdout.write(bytes.subarray(split));
+      process.stderr.write(bytes.subarray(split));
+    }, 100);
+  `;
